# CodeGraphContext ignore patterns
# 标准模板
node_modules/
venv/
.venv/
env/
.env/
dist/
build/
target/
out/
.git/
__pycache__/

# 二进制 / 媒体
*.png
*.jpg
*.jpeg
*.gif
*.svg
*.mp4
*.mp3
*.zip
*.tar
*.gz

# 大体积生成物（tree-sitter 解析慢）
*.html
*.xml

# ── 本项目特有 ──
# cargo 构建产物：496 M / 1169 文件，占全仓一半以上
deploy/fsm/target/
# Rockchip 的 NPU 头文件与运行时（非本项目代码）
deploy/fsm/vendor/
# 训练产物与导出
logs/
tasks/*/out/
out/
# 机器人网格与材质（93 个二进制资产）
assets/
tasks/*/media/
# 训练 checkpoint 与导出模型
*.pt
*.onnx
*.rknn
*.npz
*.obj
*.stl
# 编辑器/工具状态
.openchamber/
mjrl_lab.egg-info/
